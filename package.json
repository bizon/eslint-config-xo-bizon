{
  "name": "eslint-config-xo-bizon",
  "version": "4.5.0",
  "description": "ESLint shareable config to be used with xo",
  "repository": "https://github.com/bizon/eslint-config-xo-bizon",
  "author": "Bertrand Marron <bertrand.marron@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check:ts": "tsc --noEmit",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "xo": ">=4"
  },
  "devDependencies": {
    "@bizon/semantic-release-config": "^3.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "xo": "^5.0.1"
  },
  "keywords": [
    "eslintconfig",
    "xo",
    "xoxo",
    "code",
    "quality",
    "style",
    "lint",
    "linter",
    "jscs",
    "jshint",
    "jslint",
    "eslint",
    "validate",
    "code style",
    "standard",
    "strict",
    "check",
    "checker",
    "verify",
    "enforce",
    "hint",
    "bizon"
  ],
  "release": {
    "extends": "@bizon/semantic-release-config"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
